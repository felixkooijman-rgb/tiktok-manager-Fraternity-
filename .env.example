# Copy to .env. Never commit .env.

# Path to the Fraternity poster repository (match data, posters, fonts)
FRATERNITY_DIR=../Fraternity

# --- TikTok (developers.tiktok.com app with Login Kit + Content Posting API + Display API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the TikTok developer portal
TIKTOK_REDIRECT_URI=http://localhost:4300/auth/tiktok/callback

# Public HTTPS base URL where slides are served from. For PHOTO posts TikTok only accepts
# PULL_FROM_URL from a URL prefix/domain you verified in the developer portal.
PUBLIC_MEDIA_BASE_URL=
# Optional shell command that uploads a post folder to that host. {dir} and {postId} are substituted.
# e.g. rclone copy {dir} r2:fraternity-media/{postId}
MEDIA_SYNC_COMMAND=

# --- Optional AI text (captions, proof-reading, extra idea angles) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Optional image sources ---
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
OPENAI_API_KEY=

# --- Dashboard ---
DASHBOARD_PORT=4300
# Set a password when the dashboard is reachable from outside localhost (user: admin)
DASHBOARD_PASSWORD=
